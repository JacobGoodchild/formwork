<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FrameworkApp</RootNamespace>
    <AssemblyName>FrameworkApp</AssemblyName>
    <!-- Properties\AssemblyInfo.cs has the attributes the SDK would generate. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Penguin Forms: on Windows (college), the real Windows Forms on .NET Framework, as the project was. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net481</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Penguin Forms: anywhere else (Linux at home), NetForms runs the same code on .NET 10. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <PackageReference Include="NetForms" Version="0.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Legacy\Legacy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Legacy\**" />
    <EmbeddedResource Remove="Legacy\**" />
    <None Remove="Legacy\**" />
    <Compile Remove="Unlisted.cs" />
    <Compile Update="Form1.Designer.cs">
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <Content Include="Picture\closed.png" />
  </ItemGroup>

  <!-- Penguin Forms: on Linux, paint Windows 10/11's system colours (light grey #F0F0F0 forms, not .NET's beige),
       so the running app looks like the designer. Only adds a generated file under obj/; your code files are unchanged.
       To turn it off, add <PenguinFormsWindowsColours>false</PenguinFormsWindowsColours> to a PropertyGroup. -->
  <Target Name="PenguinFormsWindowsColours" BeforeTargets="CoreCompile" Condition="'$(OS)' != 'Windows_NT' and '$(PenguinFormsWindowsColours)' != 'false' and '$(Language)' == 'C#'">
    <WriteLinesToFile File="$(IntermediateOutputPath)PenguinForms.WindowsColours.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="// &lt;auto-generated /&gt; by Penguin Forms (see the project file);#pragma warning disable;internal static class PenguinFormsWindowsColours { [System.Runtime.CompilerServices.ModuleInitializer] internal static void Install() { try { var t = typeof(System.Drawing.Graphics).Assembly.GetType(&quot;System.Drawing.HermeticRendering&quot;)%3B var p = t?.GetField(&quot;WindowsDefaultPalette&quot;)?.GetValue(null)%3B if (p != null) t!.GetProperty(&quot;Palette&quot;)?.SetValue(null, p)%3B } catch (System.Exception) { } } }" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PenguinForms.WindowsColours.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)PenguinForms.WindowsColours.g.cs" />
    </ItemGroup>
  </Target>

</Project>
