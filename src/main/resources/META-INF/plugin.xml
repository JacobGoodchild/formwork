<idea-plugin>
  <id>dev.formwork</id>
  <name>Formwork</name>
  <vendor>Formwork</vendor>
  <description><![CDATA[
    <p>The Windows Forms drag-and-drop designer for Rider on Linux, laid out like Visual Studio's:
    a Design tab for each form, the toolbox, the property grid with Events, F7 / Shift+F7.
    Your code stays exactly as Visual Studio writes it, so a form designed at home opens unchanged
    in Visual Studio, and the other way round.</p>
    <p>Built on <a href="https://github.com/Go-Forms/.NetForms">NetForms</a> (MIT licence),
    which runs WinForms code on Linux and paints the form. Formwork makes no network requests of its own.</p>
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.jcef</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileEditorProvider implementation="dev.formwork.editor.DesignerEditorProvider"/>
    <editorTabTitleProvider implementation="dev.formwork.editor.DesignerTabTitleProvider" order="first"/>
    <notificationGroup id="Formwork" displayType="BALLOON"/>
    <toolWindow id="Toolbox" anchor="left" secondary="false" icon="AllIcons.Toolwindows.ToolWindowPalette"
                factoryClass="dev.formwork.toolwindows.ToolboxToolWindowFactory"/>
    <toolWindow id="Document Outline" anchor="left" secondary="true" icon="AllIcons.Toolwindows.ToolWindowStructure"
                factoryClass="dev.formwork.toolwindows.OutlineToolWindowFactory"/>
    <toolWindow id="Properties" anchor="right" secondary="false" icon="AllIcons.Toolwindows.ToolWindowPalette"
                factoryClass="dev.formwork.toolwindows.PropertiesToolWindowFactory"/>
    <applicationService serviceImplementation="dev.formwork.settings.FormworkSettings"/>
    <postStartupActivity implementation="dev.formwork.project.LinuxProjectNotifier"/>
  </extensions>

  <applicationListeners>
    <listener class="dev.formwork.project.FormworkProjectListener" topic="com.intellij.openapi.project.ProjectCloseListener"/>
  </applicationListeners>

  <projectListeners>
    <listener class="dev.formwork.editor.DesignerTabListener" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
  </projectListeners>

  <actions>
    <group id="Formwork.FormGroup">
      <action id="Formwork.ViewCode" class="dev.formwork.actions.ViewCodeAction" text="View Code" description="Show the form's code (Form1.cs)">
        <keyboard-shortcut keymap="$default" first-keystroke="F7"/>
      </action>
      <action id="Formwork.ViewDesigner" class="dev.formwork.actions.ViewDesignerAction" text="View Designer" description="Show the form in the Windows Forms designer">
        <keyboard-shortcut keymap="$default" first-keystroke="shift F7"/>
      </action>
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
      <add-to-group group-id="EditorTabPopupMenu" anchor="first"/>
      <separator/>
    </group>
    <group id="Formwork.AddGroup">
      <action id="Formwork.AddForm" class="dev.formwork.project.AddFormAction$Form" text="Windows Form…" description="Add a Windows Form (Form2.cs and Form2.Designer.cs), as Visual Studio does"/>
      <action id="Formwork.AddUserControl" class="dev.formwork.project.AddFormAction$UserControl" text="User Control (Windows Forms)…" description="Add a Windows Forms UserControl"/>
      <add-to-group group-id="NewGroup" anchor="first"/>
    </group>
    <action id="Formwork.MakeLinux" class="dev.formwork.project.MakeLinuxAction" text="Make This Project Work on Linux Too…"
            description="Change the .csproj so it builds with NetForms on Linux and with Windows Forms on Windows (a backup is kept)">
      <add-to-group group-id="ToolsMenu" anchor="first"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
    </action>
    <group id="Formwork.FormatMenu" text="F_ormat" popup="true" description="Visual Studio's Format menu for the Windows Forms designer">
      <group id="Formwork.Format.Align" text="Align" popup="true">
        <action id="Formwork.Format.left" class="dev.formwork.actions.FormatAction" text="Lefts"/>
        <action id="Formwork.Format.center" class="dev.formwork.actions.FormatAction" text="Centers"/>
        <action id="Formwork.Format.right" class="dev.formwork.actions.FormatAction" text="Rights"/>
        <separator/>
        <action id="Formwork.Format.top" class="dev.formwork.actions.FormatAction" text="Tops"/>
        <action id="Formwork.Format.middle" class="dev.formwork.actions.FormatAction" text="Middles"/>
        <action id="Formwork.Format.bottom" class="dev.formwork.actions.FormatAction" text="Bottoms"/>
        <separator/>
        <action id="Formwork.Format.toGrid" class="dev.formwork.actions.FormatAction" text="to Grid"/>
      </group>
      <group id="Formwork.Format.MakeSameSize" text="Make Same Size" popup="true">
        <action id="Formwork.Format.sameWidth" class="dev.formwork.actions.FormatAction" text="Width"/>
        <action id="Formwork.Format.sameHeight" class="dev.formwork.actions.FormatAction" text="Height"/>
        <action id="Formwork.Format.sameSize" class="dev.formwork.actions.FormatAction" text="Both"/>
        <separator/>
        <action id="Formwork.Format.sizeToGrid" class="dev.formwork.actions.FormatAction" text="Size to Grid"/>
      </group>
      <group id="Formwork.Format.HorizontalSpacing" text="Horizontal Spacing" popup="true">
        <action id="Formwork.Format.spaceX" class="dev.formwork.actions.FormatAction" text="Make Equal"/>
        <action id="Formwork.Format.incX" class="dev.formwork.actions.FormatAction" text="Increase"/>
        <action id="Formwork.Format.decX" class="dev.formwork.actions.FormatAction" text="Decrease"/>
        <action id="Formwork.Format.removeX" class="dev.formwork.actions.FormatAction" text="Remove"/>
      </group>
      <group id="Formwork.Format.VerticalSpacing" text="Vertical Spacing" popup="true">
        <action id="Formwork.Format.spaceY" class="dev.formwork.actions.FormatAction" text="Make Equal"/>
        <action id="Formwork.Format.incY" class="dev.formwork.actions.FormatAction" text="Increase"/>
        <action id="Formwork.Format.decY" class="dev.formwork.actions.FormatAction" text="Decrease"/>
        <action id="Formwork.Format.removeY" class="dev.formwork.actions.FormatAction" text="Remove"/>
      </group>
      <group id="Formwork.Format.CenterinForm" text="Center in Form" popup="true">
        <action id="Formwork.Format.centerH" class="dev.formwork.actions.FormatAction" text="Horizontally"/>
        <action id="Formwork.Format.centerV" class="dev.formwork.actions.FormatAction" text="Vertically"/>
      </group>
      <separator/>
      <group id="Formwork.Format.Order" text="Order" popup="true">
        <action id="Formwork.Format.bringToFront" class="dev.formwork.actions.FormatAction" text="Bring to Front"/>
        <action id="Formwork.Format.sendToBack" class="dev.formwork.actions.FormatAction" text="Send to Back"/>
      </group>
      <separator/>
      <action id="Formwork.Format.lock" class="dev.formwork.actions.FormatAction" text="Lock Controls" description="Lock the controls so they can't be moved or resized by accident"/>
      <add-to-group group-id="MainMenu" relative-to-action="CodeMenu" anchor="after"/>
    </group>
    <action id="Formwork.Format.tabOrder" class="dev.formwork.actions.FormatAction" text="Tab Order" description="Show the tab order on the form: click the controls in the order the Tab key should visit them">
      <add-to-group group-id="ViewMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
