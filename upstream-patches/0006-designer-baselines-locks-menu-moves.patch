+    /// <summary>The value of the <c>&lt;metadata&gt;</c> entry <paramref name="name"/> (<c>button1.Locked</c>), or null.</summary>
+    public static string? GetMetadata(string resx, string name)
+    {
+        var m = Metadata(resx, name);
+        if (m == null) return null;
+        var v = Regex.Match(m.Value, "<value>(.*?)</value>", RegexOptions.Singleline);
+        return v.Success ? System.Net.WebUtility.HtmlDecode(v.Groups[1].Value) : "";
+    }
+
+    /// <summary>
+    /// <paramref name="resx"/> (null: a new file) with the <c>&lt;metadata&gt;</c> entry <paramref name="name"/> set to
+    /// <paramref name="value"/>, as VS writes design-time properties such as Locked; a null value takes it out.
+    /// Returns null when there is no file and nothing to set.
+    /// </summary>
+    public static string? SetMetadata(string? resx, string name, string? value, string type)
+    {
+        if (resx == null && value == null) return null;
+        string nl = resx != null && !resx.Contains("\r\n", StringComparison.Ordinal) ? "\n" : "\r\n";
+        var s = resx ?? NewFile.Replace("\r\n", "\n").Replace("\n", nl) + nl + "</root>";
+        var m = Metadata(s, name);
+        if (value == null)
+        {
+            if (m == null) return s;
+            int start = LineStart(s, m.Index);
+            int end = m.Index + m.Length;
+            if (s.AsSpan(end).StartsWith(nl)) end += nl.Length;
+            return s.Remove(start, end - start);
+        }
+        var element = "<metadata name=\"" + System.Security.SecurityElement.Escape(name) + "\" type=\"" + System.Security.SecurityElement.Escape(type) + "\">" + nl
+            + "    <value>" + System.Security.SecurityElement.Escape(value) + "</value>" + nl + "  </metadata>";
+        if (m != null) return s.Remove(m.Index, m.Length).Insert(m.Index, element);
+        int close = s.LastIndexOf("</root>", StringComparison.Ordinal);
+        if (close < 0) throw new InvalidOperationException("The .resx has no </root>.");
+        return s.Insert(LineStart(s, close), "  " + element + nl);
+    }
+
+    private static Match? Metadata(string s, string name)
+    {
+        var m = Regex.Match(s, "<metadata\\s+name=\"" + Regex.Escape(System.Security.SecurityElement.Escape(name)) + "\"[^>]*?(/>|>.*?</metadata>)", RegexOptions.Singleline);
+        return m.Success ? m : null;
+    }
+
     private static Match? Entry(string s, string name)
     {
