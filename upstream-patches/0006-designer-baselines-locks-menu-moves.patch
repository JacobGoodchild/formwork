diff --git a/src/NetForms.Design/DesignSurface.MoveItem.cs b/src/NetForms.Design/DesignSurface.MoveItem.cs
new file mode 100644
index 0000000..a8abea0
--- /dev/null
+++ b/src/NetForms.Design/DesignSurface.MoveItem.cs
@@ -0,0 +1,53 @@
+using System.Linq;
+using System.Windows.Forms;
+
+namespace NetForms.Design;
+
+/// <summary>Moving a tool strip item into another menu or strip by dragging, as VS's ToolStrip designer allows.</summary>
+public sealed partial class DesignSurface
+{
+    /// <summary>
+    /// moveItem: <paramref name="item"/> goes into <paramref name="owner"/> (a menu bar or tool strip, or a menu item:
+    /// its DropDownItems) at <paramref name="index"/> (null: at the end), out of the collection it was in.
+    /// </summary>
+    private void MoveItem(object item, object owner, int? index)
+    {
+        if (item is not ToolStripItem moving) throw new DesignerEditException("Only a menu or tool strip item can be moved into a menu.");
+        var target = owner switch
+        {
+            ToolStripDropDownItem d => d.DropDownItems,
+            ToolStrip strip when owner is not ToolStripDropDown => strip.Items,
+            _ => throw new DesignerEditException($"'{Model.FindByInstance(owner)?.Name ?? owner.GetType().Name}' does not hold menu or tool strip items."),
+        };
+        // Not into itself, nor into one of its own sub-menus.
+        for (var o = owner as ToolStripItem; o != null; o = o.OwnerItem ?? OwnerOf(o))
+            if (ReferenceEquals(o, moving)) throw new DesignerEditException("A menu item cannot go into its own sub-menu.");
+        if (!NewItemTypes(owner).Any(t => t.IsInstanceOfType(moving)))
+            throw new DesignerEditException($"A {moving.GetType().Name} cannot go into {Model.FindByInstance(owner)?.Name ?? owner.GetType().Name}.");
+
+        var source = CollectionOf(moving);
+        int at = index ?? target.Count;
+        if (source != null)
+        {
+            // Counting without the item itself, when it moves along its own collection.
+            if (ReferenceEquals(source, target) && source.IndexOf(moving) < at) at--;
+            source.Remove(moving);
+        }
+        target.Insert(System.Math.Clamp(at, 0, target.Count), moving);
+    }
+
+    /// <summary>The collection a tool strip item is in on the form (a strip's Items, a menu item's DropDownItems).</summary>
+    private ToolStripItemCollection? CollectionOf(ToolStripItem item)
+    {
+        foreach (var c in Model.Components)
+        {
+            if (c.Instance is ToolStripDropDownItem d && d.DropDownItems.Contains(item)) return d.DropDownItems;
+            if (c.Instance is ToolStrip s && s.Items.Contains(item)) return s.Items;
+        }
+        return null;
+    }
+
+    /// <summary>The menu item whose DropDownItems hold <paramref name="item"/>, or null.</summary>
+    private ToolStripItem? OwnerOf(ToolStripItem item) =>
+        Model.Components.Select(c => c.Instance).OfType<ToolStripDropDownItem>().FirstOrDefault(d => d.DropDownItems.Contains(item));
+}
diff --git a/src/NetForms.Design/DesignSurface.Snaplines.cs b/src/NetForms.Design/DesignSurface.Snaplines.cs
new file mode 100644
index 0000000..78d2b36
--- /dev/null
+++ b/src/NetForms.Design/DesignSurface.Snaplines.cs
@@ -0,0 +1,165 @@
+using System;
+using System.Collections.Generic;
+using System.Drawing;
+using System.Windows.Forms;
+using NetForms.Design.Serialization;
+
+namespace NetForms.Design;
+
+/// <summary>
+/// Two things Visual Studio's control designers add: the text baseline a control offers as a (magenta) snapline,
+/// and the design-time Locked property, which VS keeps in the form's .resx rather than in the code.
+/// </summary>
+public sealed partial class DesignSurface
+{
+    private const ContentAlignment AnyTop = ContentAlignment.TopLeft | ContentAlignment.TopCenter | ContentAlignment.TopRight;
+    private const ContentAlignment AnyMiddle = ContentAlignment.MiddleLeft | ContentAlignment.MiddleCenter | ContentAlignment.MiddleRight;
+
+    /// <summary>
+    /// Where the control's text baseline is, in pixels from its top, as the VS designers place their baseline snapline
+    /// (dotnet/winforms DesignerUtils.GetTextBaseline plus each designer's offsets: ButtonBaseDesigner, LabelDesigner,
+    /// TextBoxBaseDesigner, ComboBoxDesigner, DateTimePickerDesigner, UpDownBaseDesigner). Null: no baseline.
+    /// </summary>
+    internal static int? TextBaseline(Control c)
+    {
+        switch (c)
+        {
+            case CheckBox box:
+                return Baseline(c, box.TextAlign, c.Height) + (box.Appearance == Appearance.Normal ? CheckBoxOffset(box.TextAlign, box.FlatStyle) : ButtonOffset(box.TextAlign, box.FlatStyle));
+            case RadioButton radio:
+                return Baseline(c, radio.TextAlign, c.Height) + (radio.Appearance == Appearance.Normal ? RadioOffset(radio.TextAlign, radio.FlatStyle) : ButtonOffset(radio.TextAlign, radio.FlatStyle));
+            case ButtonBase button:
+                return Baseline(c, button.TextAlign, c.Height) + ButtonOffset(button.TextAlign, button.FlatStyle);
+            case Label label:
+            {
+                // Windows' client area leaves out the border: 1 px a side for FixedSingle, 2 for Fixed3D.
+                int border = label.BorderStyle switch { BorderStyle.FixedSingle => 2, BorderStyle.Fixed3D => 4, _ => 0 };
+                int baseline = Baseline(c, label.TextAlign, c.Height - border);
+                if (!label.AutoSize)
+                {
+                    bool bottom = (label.TextAlign & (AnyTop | AnyMiddle)) == 0;
+                    baseline += label.BorderStyle == BorderStyle.None ? (bottom ? -1 : 0) : (bottom ? 0 : 1);
+                }
+                return baseline;
+            }
+            case TextBoxBase text:
+                return Baseline(c, ContentAlignment.TopLeft, c.Height) + text.BorderStyle switch { BorderStyle.FixedSingle => 2, BorderStyle.Fixed3D => 3, _ => 0 };
+            case ComboBox:
+                return Baseline(c, ContentAlignment.TopLeft, c.Height) + 3;
+            case DateTimePicker:
+                return Baseline(c, ContentAlignment.MiddleLeft, c.Height - 4) + 2;
+            case UpDownBase upDown:
+                return Baseline(c, ContentAlignment.TopLeft, c.Height) + (upDown.BorderStyle == BorderStyle.None ? -1 : 2);
+            default:
+                return null;
+        }
+    }
+
+    /// <summary>GetTextBaseline: the font's ascent (+1, as GDI's tmAscent + 1) placed as the alignment puts the text.</summary>
+    private static int Baseline(Control c, ContentAlignment alignment, int faceHeight)
+    {
+        var font = c.Font;
+        var family = font.FontFamily;
+        // Segoe UI's own Windows metrics (usWinAscent 2210, usWinDescent 514 per 2048): the font that stands in for it
+        // on Linux has its line squeezed to match Segoe UI's line height, not its ascent.
+        bool segoe = string.Equals(family.Name, "Segoe UI", StringComparison.OrdinalIgnoreCase);
+        float em = segoe ? 2048 : family.GetEmHeight(font.Style);
+        float scale = font.SizeInPoints * 96f / 72f / em;
+        // GDI rounds the ascent and the descent each to whole pixels; tmHeight is their sum.
+        int ascent = (int)Math.Round((segoe ? 2210 : family.GetCellAscent(font.Style)) * scale);
+        int height = ascent + (int)Math.Round((segoe ? 514 : family.GetCellDescent(font.Style)) * scale);
+        int fontAscent = ascent + 1;
+        if ((alignment & AnyTop) != 0) return fontAscent;
+        if ((alignment & AnyMiddle) != 0) return faceHeight / 2 - height / 2 + fontAscent;
+        return faceHeight - height + fontAscent;
+    }
+
+    private static bool Middle(ContentAlignment a) => (a & AnyMiddle) != 0;
+    private static bool Top(ContentAlignment a) => (a & AnyTop) != 0;
+
+    private static int ButtonOffset(ContentAlignment a, FlatStyle style)
+    {
+        if (Middle(a)) return 0;
+        int d = style switch { FlatStyle.System => 3, FlatStyle.Flat => 5, _ => 4 };
+        return Top(a) ? d : -d;
+    }
+
+    private static int CheckBoxOffset(ContentAlignment a, FlatStyle style)
+    {
+        if (Middle(a)) return style is FlatStyle.Standard or FlatStyle.System ? -1 : 0;
+        if (Top(a)) return style switch { FlatStyle.Standard => 1, FlatStyle.System => 0, _ => 2 };
+        return style switch { FlatStyle.Standard => -3, FlatStyle.System => 0, _ => -2 };
+    }
+
+    private static int RadioOffset(ContentAlignment a, FlatStyle style)
+    {
+        if (Middle(a)) return style == FlatStyle.System ? -1 : 0;
+        if (style == FlatStyle.System) return 0;
+        return Top(a) ? 2 : -2;
+    }
+
+    // --- Locked ------------------------------------------------------------------------------------
+
+    /// <summary>The type VS writes on a <c>Locked</c> metadata entry.</summary>
+    private const string BooleanResxType = "System.Boolean, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089";
+
+    private const string LockedDescription = "The Locked property determines if we can move or resize the control.";
+
+    /// <summary>The .resx name VS keeps a component's Locked under: <c>button1.Locked</c>, <c>$this.Locked</c> for the form.</summary>
+    private string? LockedKey(object target)
+    {
+        var component = Model.FindByInstance(target);
+        if (component == null || target is not Control) return null;
+        return (component.IsRoot ? "$this" : component.Name) + ".Locked";
+    }
+
+    /// <summary>Locked in the designer (Format → Lock Controls, or the Locked property): it can be selected, not moved or resized.</summary>
+    internal bool IsLocked(object target)
+    {
+        var key = LockedKey(target);
+        return key != null && ResxSource != null
+            && string.Equals(ResxWriter.GetMetadata(ResxSource, key)?.Trim(), "True", StringComparison.OrdinalIgnoreCase);
+    }
+
+    /// <summary>setProp Locked: written to the .resx as VS does (True), taken out when unlocked.</summary>
+    private void SetLocked(object target, string? value)
+    {
+        var key = LockedKey(target) ?? throw new DesignerEditException($"'{target.GetType().Name}' cannot be locked.");
+        bool on = string.Equals(value?.Trim(), "True", StringComparison.OrdinalIgnoreCase);
+        if (!on && !string.Equals(value?.Trim(), "False", StringComparison.OrdinalIgnoreCase))
+            throw new DesignerEditException($"'{value}' is not a valid value for Locked (True or False).");
+        ResxSource = ResxWriter.SetMetadata(ResxSource, key, on ? "True" : null, BooleanResxType);
+    }
+
+    /// <summary>A renamed control keeps its lock (VS renames the .resx entries with it).</summary>
+    private void RenameLocked(string oldName, string newName)
+    {
+        if (ResxSource == null || !string.Equals(ResxWriter.GetMetadata(ResxSource, oldName + ".Locked")?.Trim(), "True", StringComparison.OrdinalIgnoreCase)) return;
+        ResxSource = ResxWriter.SetMetadata(ResxSource, oldName + ".Locked", null, BooleanResxType);
+        ResxSource = ResxWriter.SetMetadata(ResxSource, newName + ".Locked", "True", BooleanResxType);
+    }
+
+    /// <summary>A deleted control's lock goes with it (VS drops its .resx entries).</summary>
+    private void PruneLocks()
+    {
+        if (ResxSource == null) return;
+        foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(ResxSource, "<metadata\\s+name=\"([^\"]+)\\.Locked\""))
+        {
+            var name = System.Net.WebUtility.HtmlDecode(m.Groups[1].Value);
+            if (name == "$this" || Model.Find(name) != null) continue;
+            ResxSource = ResxWriter.SetMetadata(ResxSource, name + ".Locked", null, BooleanResxType);
+        }
+    }
+
+    /// <summary>The grid's Locked row (Design category), for controls and the form, as VS lists it.</summary>
+    private void AddLockedRow(object target, List<DesignerPropertyRow> rows)
+    {
+        if (LockedKey(target) == null) return;
+        bool locked = IsLocked(target);
+        rows.Add(new DesignerPropertyRow
+        {
+            Name = "Locked", Category = "Design", Description = LockedDescription, Type = "Boolean",
+            Value = locked ? "True" : "False", Editor = "bool", Modified = locked,
+        });
+    }
+}
