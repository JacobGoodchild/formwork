+	/** Selects a toolbox tool, as VS does: the next click on the form places it (null: back to the Pointer). */
+	function arm(item) {
+		state.armed = item && !item.unavailable ? item : null;
+		document.body.classList.toggle('tool-armed', !!state.armed);
+		renderToolbox();
+		if (window.__netformsToolChanged) window.__netformsToolChanged(state.armed ? state.armed.type : null);
+	}
+
+	/**
+	 * Places a control from the toolbox at a point of the canvas, into whatever container is there (a table's cell,
+	 * a flow's place), optionally with a size (a rectangle drawn with the tool). Tray components go to the tray.
+	 */
+	function placeTool(type, p, size) {
+		if (!state.view) return;
+		const item = toolboxItem(type) || { type };
+		state.selectNew = new Set(allIds());
+		if (item.tray) { apply([{ op: 'add', type }]); return; }
+		const strip = item.strip;
+		if (!strip && G.stripsPanelAt(state.view.items, p.x, p.y)) { toast(T('A ToolStripPanel takes tool strips only.'), 'info'); return; }
+		const target = G.dropTarget(state.view.items, p.x, p.y, new Set(), strip);
+		const c = containerRect(target ? target.id : '');
+		if (target && target.table) {
+			const cell = G.cellAt(target.table, p.x, p.y);
+			apply([{ op: 'add', type, parent: target.id, column: cell.column, row: cell.row }]);
+			return;
+		}
+		if (target && target.flow) {
+			apply([{ op: 'add', type, parent: target.id, index: flowDrop(target, p, null).index }]);
+			return;
+		}
+		const op = { op: 'add', type, parent: target ? target.id : '', x: Math.max(0, p.x - c.x), y: Math.max(0, p.y - c.y) };
+		if (size && size.w >= 4 && size.h >= 4) { op.w = size.w; op.h = size.h; }
+		apply([op]);
+	}
+
+	/** A tool dragged from the toolbox with the mouse: dropped on the form, it is placed where the pointer is. */
+	function startToolDrag(e, item) {
+		if (e.button !== 0) return;
+		state.toolDragged = false;
+		const start = { x: e.clientX, y: e.clientY };
+		let ghost = null;
+		const move = (ev) => {
+			if (!ghost && Math.abs(ev.clientX - start.x) + Math.abs(ev.clientY - start.y) < 5) return;
+			if (!ghost) {
+				ghost = el('div', 'tool-ghost', item.name);
+				document.body.append(ghost);
+				state.toolDragged = true;
+			}
+			ghost.style.left = ev.clientX + 8 + 'px';
+			ghost.style.top = ev.clientY + 8 + 'px';
+		};
+		const up = (ev) => {
+			window.removeEventListener('mousemove', move);
+			if (!ghost) return;
+			ghost.remove();
+			setTimeout(() => { state.toolDragged = false; }, 0);
+			const canvas = state.canvas;
+			if (!canvas || !state.view || state.busy) return;
+			const r = canvas.getBoundingClientRect();
+			if (ev.clientX < r.left || ev.clientY < r.top || ev.clientX > r.right || ev.clientY > r.bottom) return;
+			arm(null);
+			placeTool(item.type, canvasPoint(ev), null);
+		};
+		window.addEventListener('mousemove', move);
+		window.addEventListener('mouseup', up, { once: true });
+	}
