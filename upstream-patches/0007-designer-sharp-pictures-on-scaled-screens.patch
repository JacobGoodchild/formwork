diff --git a/src/NetForms.Design/DesignSurface.Scale.cs b/src/NetForms.Design/DesignSurface.Scale.cs
new file mode 100644
index 0000000..838d5c7
--- /dev/null
+++ b/src/NetForms.Design/DesignSurface.Scale.cs
@@ -0,0 +1,35 @@
+using System;
+using System.Drawing;
+using System.Drawing.Imaging;
+using System.IO;
+using System.Windows.Forms;
+
+namespace NetForms.Design;
+
+/// <summary>
+/// The pictures the client shows (the form, an open menu) are painted at the screen's pixel density, so on a scaled
+/// screen (150 %, 200 %) they are as sharp as the editor around them instead of a 1x picture stretched. Everything
+/// else - where items are, hit-testing, edits - stays in form pixels.
+/// </summary>
+public sealed partial class DesignSurface
+{
+    private float _renderScale = 1f;
+
+    /// <summary>Device pixels per form pixel for the pictures: 1 to 4, in quarter steps.</summary>
+    public float RenderScale
+    {
+        get => _renderScale;
+        set => _renderScale = float.IsFinite(value) ? Math.Clamp(MathF.Round(value * 4) / 4, 1f, 4f) : 1f;
+    }
+
+    /// <summary>A control painted at <paramref name="scale"/> times <paramref name="size"/>, as a base64 PNG.</summary>
+    private static string ScaledPng(Control control, Size size, float scale)
+    {
+        int w = Math.Max(1, (int)Math.Ceiling(size.Width * scale)), h = Math.Max(1, (int)Math.Ceiling(size.Height * scale));
+        using var bitmap = new Bitmap(w, h);
+        if (size.Width > 0 && size.Height > 0) control.DrawToBitmap(bitmap, new Rectangle(Point.Empty, size), scale);
+        using var png = new MemoryStream();
+        bitmap.Save(png, ImageFormat.Png);
+        return System.Convert.ToBase64String(png.ToArray());
+    }
+}
