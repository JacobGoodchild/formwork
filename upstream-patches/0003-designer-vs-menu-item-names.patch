+    /// <summary>
+    /// The name VS gives a menu item from its text: letters and digits only, first word lower-case, the others
+    /// capitalised, then "ToolStripMenuItem" ("Save &As..." → saveAsToolStripMenuItem). Null when no letter is left.
+    /// </summary>
+    internal static string? MenuItemBaseName(string text)
+    {
+        var words = new string(text.Select(c => char.IsLetterOrDigit(c) || c == ' ' ? c : c == '&' ? '\0' : ' ').Where(c => c != '\0').ToArray())
+            .Split(' ', StringSplitOptions.RemoveEmptyEntries);
+        if (words.Length == 0 || !char.IsLetter(words[0][0])) return null;
+        return string.Concat(words.Select((w, i) => i == 0 ? w.ToLowerInvariant() : char.ToUpperInvariant(w[0]) + w.Substring(1).ToLowerInvariant())) + "ToolStripMenuItem";
