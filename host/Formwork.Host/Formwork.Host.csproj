<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Penguin Forms' designer host: NetForms' DesignerProtocol (the same one its VS Code extension uses), plus
    what Rider needs: the form's files are read from Rider's editor buffers and every write is handed
    back to Rider (so Ctrl+Z and the unsaved-changes marker work), never written to disk here.
    See docs/PROTOCOL.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Formwork.Host</AssemblyName>
    <RootNamespace>Formwork.Host</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../fonts/*.ttf;../fonts/Selawik-OFL.txt" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../external/NetForms/src/NetForms.Design/NetForms.Design.csproj" />
  </ItemGroup>
</Project>
